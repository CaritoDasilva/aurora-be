ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AURORA_PORT=3000
# Por defecto el servidor solo escucha en 127.0.0.1. Para que el celular (misma WiFi) se conecte:
# AURORA_HOST=0.0.0.0
# tiny|base|small|medium|large-v2|large-v3 — 'small' es el default si se omite.
# Usar 'tiny' o 'base' si la red es lenta el día de la demo (descarga más chica y liviana).
WHISPER_MODEL=small
# Modelo del agente conversacional (por defecto claude-sonnet-5-5)
# AURORA_MODEL=claude-sonnet-5-5

# Login de la app: código fijo para pruebas con personas (6 dígitos). Sin esto,
# el código se imprime en la consola del servidor.
# AURORA_DEMO_CODE=123456
# Exigir sesión en /process, /confirm, /cancel y /profile (recomendado al probar con la app)
# AURORA_REQUIRE_AUTH=true
